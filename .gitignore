# Build output and caches
/target/
**/target/
/cache/
# The caches of before #213, moved under cache/ at the first start.
/shader-cache/
/mesh-cache/
/captures/

# The labs' external models (D-048): fetched by tools/fetch-assets.sh, never committed.
/assets/external/
# The planets' maps (#220): fetched and converted by tools/fetch-planets.sh, hundreds of MB, never
# committed.
/assets/planets/
# The ambience's bird recordings (#267): fetched by tools/fetch-sounds.sh, never committed.
/assets/sounds/

# Vendored third-party binaries and SDKs (Tracy profiler, NVIDIA Streamline): kept locally,
# never committed (126 MB and 486 MB).
/tracy/
/streamline-sdk/
/nrd-sdk/
# NVIDIA's RTXDI library (D-065's comparison, the NVIDIA RTX SDKs licence): kept locally, never
# copied into Forge's code.
/rtxdi-sdk/
# Steam Audio's SDK (forge-audio's `steam-audio` feature, #267): 181 MB, kept locally.
/steam-audio-sdk/
# luau-lsp (MIT, JohnnyMorganz/luau-lsp), its release unpacked for tools/luau-check.sh (#319).
/luau-lsp/
/fidelityfx-sdk/
# AMD's FSR SDK 2.4.0 (its signed DLLs for `--fsr-amd`), a junction to the download beside the repo.
/fsr-sdk/

# Compiled shaders are rebuilt from shaders/*.slang
*.spv

# Secrets and per-machine configuration
.env
.env.*
server-auth.md
config/server-identity/
# The HDR calibration saved by the demos (F5, issue #125): per machine and monitor.
/settings/

# Editors and OS noise
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# The owner's settings file (D-069): edited by hand, read at start, never committed.
/forge.cfg

# The owner's bug-screenshot inbox (each image an issue to file) and reference photos from the
# web (third-party): kept locally, never committed.
/reports/anomalies/
/reports/real pictures/
# Windows shortcuts.
*.lnk
