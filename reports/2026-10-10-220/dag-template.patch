+//! A cluster DAG for every mesh of one connectivity (#220): the planet's tiles, all a grid of the
+//! same triangles over different ground.
+//!
+//! [`crate::build_dag`] simplifies and clusters a mesh level by level, a fifth of a second for a
+//! tile's 133 000 triangles: most of it meshoptimizer's clustering, the rest its simplifier. Both
+//! only decide *which* triangles each level keeps and how they are grouped. A [`DagTemplate`]
+//! makes those decisions once, on a stand-in mesh, and a mesh with the same triangles takes them
+//! over ([`crate::MeshletMesh::build_from`]). Only what depends on the positions is computed for
+//! it: each cluster's bounds and normal cone, each group's sphere and its error.
+//!
+//! - **Watertight whatever the positions.** A group's simplification keeps the vertices its
+//!   border shares with other groups, and that is a matter of which vertices, not where they
+//!   lie: every cut through the DAG closes as the template's does.
+//! - **A group's error is measured:** each vertex its simplification removed is a probe, paired
+//!   in the template with the produced triangle over it (in the plane the mesh lies over). The
+//!   error is the probes' largest distance from their triangles, at least the members' own:
+//!   monotonic up the DAG, as [`crate::build_dag`]'s.
+//! - **The levels are as fine everywhere as the stand-in's ground was rough there.** Over even
+//!   noise, each level is even. A mesh flat in places then keeps more triangles there than a DAG
+//!   of its own would, and draws them only where its errors ask for them.
+
+use glam::{Vec2, Vec3};
+use meshopt::VertexDataAdapter;
+
+use crate::lod::{self, ClusterDag, MAX_LEVELS};
+use crate::meshlet::{GpuVertex, split_sections};
+use crate::procedural::TriMesh;
+
+/// A DAG's decisions for every mesh with one mesh's triangles (see the module notes).
+#[derive(Clone)]
+pub struct DagTemplate {
+    /// The stand-in's DAG: its tables, groups and levels. Its bounds and errors are replaced.
+    dag: ClusterDag,
+    /// The stand-in's triangle list before the DAG's reordering, which a mesh must repeat.
+    triangles: Vec<u32>,
+    /// Vertices of the stand-in.
+    vertex_count: usize,
+    /// Every group, in the order of its number.
+    groups: Vec<Group>,
+}
+
+/// A group of the template's DAG.
+#[derive(Clone)]
+struct Group {
+    /// The clusters it consumed.
+    members: Vec<u32>,
+    /// The clusters its simplification produced (none when it stalled: its members are roots).
+    produced: Vec<u32>,
+    /// The vertices its simplification removed, each with the produced triangle over it: the
+    /// vertex, then the triangle's three vertices.
+    probes: Vec<[u32; 4]>,
+}
+
+impl DagTemplate {
+    /// The template of `mesh`'s triangles, simplified over its positions. `flat` places every
+    /// vertex in the plane the mesh lies over (a grid's sample coordinates), where a removed
+    /// vertex is paired with the produced triangle over it. The mesh must have no sections.
+    pub fn new(mesh: &TriMesh, flat: &[[f32; 2]]) -> Self {
+        let (vertices, indices, sections, _) = split_sections(mesh);
+        assert_eq!(
+            vertices.len(),
+            mesh.positions.len(),
+            "a template's mesh has no sections"
+        );
+        assert_eq!(flat.len(), vertices.len(), "a flat place for every vertex");
+        let reordered = meshopt::optimize_vertex_cache(&indices, vertices.len());
+        let dag = lod::build_dag(&reordered, &vertices, &sections, 0.0, MAX_LEVELS);
+        let group_count = dag
+            .cluster_group
+            .iter()
+            .chain(&dag.cluster_source)
+            .filter(|&&g| g != lod::NO_GROUP)
+            .map(|&g| g as usize + 1)
+            .max()
+            .unwrap_or(0);
+        let mut groups = vec![
+            Group {
+                members: Vec::new(),
+                produced: Vec::new(),
+                probes: Vec::new(),
+            };
+            group_count
+        ];
+        for c in 0..dag.meshlets.len() {
+            if dag.cluster_group[c] != lod::NO_GROUP {
+                groups[dag.cluster_group[c] as usize].members.push(c as u32);
+            }
+            if dag.cluster_source[c] != lod::NO_GROUP {
+                groups[dag.cluster_source[c] as usize]
+                    .produced
+                    .push(c as u32);
+            }
+        }
+        let mut kept = vec![false; vertices.len()];
+        for group in &mut groups {
+            if group.produced.is_empty() {
+                continue;
+            }
+            let triangles: Vec<[u32; 3]> = group
+                .produced
+                .iter()
+                .flat_map(|&c| cluster_triangles(&dag, c as usize))
+                .collect();
+            for t in &triangles {
+                for &v in t {
+                    kept[v as usize] = true;
+                }
+            }
+            let mut removed: Vec<u32> = group
+                .members
+                .iter()
+                .flat_map(|&c| cluster_vertices(&dag, c as usize).iter().copied())
+                .filter(|&v| !kept[v as usize])
+                .collect();
+            removed.sort_unstable();
+            removed.dedup();
+            let place = |v: u32| Vec2::from(flat[v as usize]);
+            for v in removed {
+                // The produced triangle over the vertex: the one it lies deepest in.
+                let p = place(v);
+                let mut best = (f32::NEG_INFINITY, [0; 3]);
+                for t in &triangles {
+                    let depth = depth_in(p, t.map(place));
+                    if depth > best.0 {
+                        best = (depth, *t);
+                    }
+                }
+                let [a, b, c] = best.1;
+                group.probes.push([v, a, b, c]);
+            }
+            for t in &triangles {
+                for &v in t {
+                    kept[v as usize] = false;
+                }
+            }
+        }
+        Self {
+            dag,
+            triangles: indices,
+            vertex_count: vertices.len(),
+            groups,
+        }
+    }
+
+    /// Whether a mesh with `triangles` over `vertex_count` vertices has the template's
+    /// triangles.
+    pub fn fits(&self, triangles: &[u32], vertex_count: usize) -> bool {
+        vertex_count == self.vertex_count && triangles == self.triangles
+    }
+
+    /// The DAG of a mesh with the template's triangles at `vertices`: the template's clusters
+    /// and groups, with the bounds, cones, spheres and errors of these positions.
+    pub fn dag_for(&self, vertices: &[GpuVertex]) -> ClusterDag {
+        assert_eq!(vertices.len(), self.vertex_count, "the template's vertices");
+        let mut dag = self.dag.clone();
+        let adapter = VertexDataAdapter::new(
+            bytemuck::cast_slice(vertices),
+            std::mem::size_of::<GpuVertex>(),
+            0,
+        )
+        .expect("vertex adapter");
+        let roots: Vec<bool> = dag
+            .meshlets
+            .iter()
+            .map(|m| m.parent_error.is_infinite())
+            .collect();
+        for (c, m) in dag.meshlets.iter_mut().enumerate() {
+            let range = dag.ranges[c];
+            let first = range.vertex_offset as usize;
+            let local = &dag.meshlet_vertices[first..first + m.vertex_count as usize];
+            let first = range.triangle_offset as usize;
+            let triangles = &dag.meshlet_triangles[first..first + 3 * m.triangle_count as usize];
+            let bounds = meshopt::compute_meshlet_bounds(
+                meshopt::Meshlet {
+                    vertices: local,
+                    triangles,
+                },
+                &adapter,
+            );
+            m.center = bounds.center;
+            m.radius = bounds.radius;
+            m.cone_apex = bounds.cone_apex;
+            m.cone_axis = bounds.cone_axis;
+            m.cone_cutoff = bounds.cone_cutoff;
+            if m.lod_level == 0 {
+                m.self_center = bounds.center;
+                m.self_radius = bounds.radius;
+                m.self_error = 0.0;
+            }
+        }
+        let position = |v: u32| Vec3::from(vertices[v as usize].position);
+        // Group by group in the order they were made: a group's members were produced by
+        // groups made before it, so their own values are final.
+        for group in &self.groups {
+            if group.produced.is_empty() {
+                continue;
+            }
+            let spheres: Vec<[f32; 4]> = group
+                .members
+                .iter()
+                .map(|&c| {
+                    let m = &dag.meshlets[c as usize];
+                    [
+                        m.self_center[0],
+                        m.self_center[1],
+                        m.self_center[2],
+                        m.self_radius,
+                    ]
+                })
+                .collect();
+            let sphere = lod::enclosing_sphere(&spheres);
+            let measured = group
+                .probes
+                .iter()
+                .map(|&[v, a, b, c]| {
+                    distance_to_triangle(position(v), [position(a), position(b), position(c)])
+                })
+                .fold(0.0_f32, f32::max);
+            let error = group
+                .members
+                .iter()
+                .map(|&c| dag.meshlets[c as usize].self_error)
+                .fold(measured, f32::max);
+            for &c in &group.members {
+                let m = &mut dag.meshlets[c as usize];
+                m.parent_center = sphere.0;
+                m.parent_radius = sphere.1;
+                m.parent_error = error;
+            }
+            for &c in &group.produced {
+                let m = &mut dag.meshlets[c as usize];
+                m.self_center = sphere.0;
+                m.self_radius = sphere.1;
+                m.self_error = error;
+            }
+        }
+        // The roots, as `build_dag` leaves them: never too coarse.
+        for (m, root) in dag.meshlets.iter_mut().zip(roots) {
+            if root {
+                m.parent_error = f32::INFINITY;
+                m.parent_center = m.self_center;
+                m.parent_radius = m.self_radius;
+            }
+        }
+        dag
+    }
+}
+
+/// Cluster `c`'s vertices (indices into the mesh's).
+fn cluster_vertices(dag: &ClusterDag, c: usize) -> &[u32] {
+    let first = dag.ranges[c].vertex_offset as usize;
+    &dag.meshlet_vertices[first..first + dag.meshlets[c].vertex_count as usize]
+}
+
+/// Cluster `c`'s triangles, in the mesh's vertex indices.
+fn cluster_triangles(dag: &ClusterDag, c: usize) -> impl Iterator<Item = [u32; 3]> + '_ {
+    let vertices = cluster_vertices(dag, c);
+    let first = dag.ranges[c].triangle_offset as usize;
+    let count = dag.meshlets[c].triangle_count as usize;
+    dag.meshlet_triangles[first..first + 3 * count]
+        .as_chunks::<3>()
+        .0
+        .iter()
+        .map(move |t| t.map(|l| vertices[l as usize]))
+}
+
+/// How deep `p` lies in the triangle `t` of the plane: its least barycentric coordinate,
+/// negative outside; minus infinity for a triangle with no area (a skirt's, seen from above).
+fn depth_in(p: Vec2, [a, b, c]: [Vec2; 3]) -> f32 {
+    let area = (b - a).perp_dot(c - a);
+    if area.abs() < 1e-9 {
+        return f32::NEG_INFINITY;
+    }
+    let u = (b - p).perp_dot(c - p) / area;
+    let v = (c - p).perp_dot(a - p) / area;
+    let w = 1.0 - u - v;
+    u.min(v).min(w)
+}
+
+/// The distance from `p` to the triangle `t` (Ericson, "Real-Time Collision Detection" §5.1.5).
+fn distance_to_triangle(p: Vec3, [a, b, c]: [Vec3; 3]) -> f32 {
+    let (ab, ac, ap) = (b - a, c - a, p - a);
+    let (d1, d2) = (ab.dot(ap), ac.dot(ap));
+    if d1 <= 0.0 && d2 <= 0.0 {
+        return p.distance(a);
+    }
+    let bp = p - b;
+    let (d3, d4) = (ab.dot(bp), ac.dot(bp));
+    if d3 >= 0.0 && d4 <= d3 {
+        return p.distance(b);
+    }
+    let vc = d1 * d4 - d3 * d2;
+    if vc <= 0.0 && d1 >= 0.0 && d3 <= 0.0 {
+        let v = d1 / (d1 - d3);
+        return p.distance(a + ab * v);
+    }
+    let cp = p - c;
+    let (d5, d6) = (ab.dot(cp), ac.dot(cp));
+    if d6 >= 0.0 && d5 <= d6 {
+        return p.distance(c);
+    }
+    let vb = d5 * d2 - d1 * d6;
+    if vb <= 0.0 && d2 >= 0.0 && d6 <= 0.0 {
+        let w = d2 / (d2 - d6);
+        return p.distance(a + ac * w);
+    }
+    let va = d3 * d6 - d5 * d4;
+    if va <= 0.0 && d4 - d3 >= 0.0 && d5 - d6 >= 0.0 {
+        let w = (d4 - d3) / ((d4 - d3) + (d5 - d6));
+        return p.distance(b + (c - b) * w);
+    }
+    let denom = 1.0 / (va + vb + vc);
+    let (v, w) = (vb * denom, vc * denom);
+    p.distance(a + ab * v + ac * w)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::MeshletMesh;
+
+    /// A grid of `n`² samples a unit apart with heights `h`, two triangles a cell, and its
+    /// samples' places in the plane.
+    fn grid(n: u32, h: impl Fn(u32, u32) -> f32) -> (TriMesh, Vec<[f32; 2]>) {
+        let mut mesh = TriMesh::default();
+        let mut flat = Vec::new();
+        for j in 0..n {
+            for i in 0..n {
+                mesh.positions.push([i as f32, h(i, j), j as f32]);
+                mesh.normals.push([0.0, 1.0, 0.0]);
+                mesh.uvs
+                    .push([i as f32 / (n - 1) as f32, j as f32 / (n - 1) as f32]);
+                flat.push([i as f32, j as f32]);
+            }
+        }
+        for j in 0..n - 1 {
+            for i in 0..n - 1 {
+                let (a, b, c, d) = (
+                    j * n + i,
+                    j * n + i + 1,
+                    (j + 1) * n + i,
+                    (j + 1) * n + i + 1,
+                );
+                mesh.indices.extend_from_slice(&[a, c, b, b, c, d]);
+            }
+        }
+        (mesh, flat)
+    }
+
+    fn noise(i: u32, j: u32, seed: u32) -> f32 {
+        let mut h = i.wrapping_mul(0x9E37_79B1) ^ j.wrapping_mul(0x85EB_CA77) ^ seed;
+        h ^= h >> 15;
+        h = h.wrapping_mul(0x2C1B_3C6D);
+        h ^= h >> 12;
+        (h & 0xFFFF) as f32 / 65535.0 - 0.5
+    }
+
+    #[test]
+    fn the_template_s_own_mesh_gets_the_bounds_its_own_dag_has() {
+        let (mesh, flat) = grid(65, |i, j| noise(i, j, 1));
+        let template = DagTemplate::new(&mesh, &flat);
+        let vertices: Vec<GpuVertex> = split_sections(&mesh).0;
+        let dag = template.dag_for(&vertices);
+        for (a, b) in dag.meshlets.iter().zip(&template.dag.meshlets) {
+            assert_eq!(a.center, b.center);
+            assert_eq!(a.radius, b.radius);
+            assert_eq!(a.cone_axis, b.cone_axis);
+            assert_eq!(a.lod_level, b.lod_level);
+            assert_eq!(a.parent_error.is_infinite(), b.parent_error.is_infinite());
+        }
+        assert!(
+            dag.clusters_per_level.len() > 3,
+            "{:?}",
+            dag.clusters_per_level
+        );
+    }
+
+    #[test]
+    fn another_ground_s_errors_rise_up_the_dag_and_its_groups_decide_together() {
+        let (stand_in, flat) = grid(65, |i, j| noise(i, j, 1));
+        let template = DagTemplate::new(&stand_in, &flat);
+        // A ridge and a flat plain: other heights over the same triangles.
+        let (mesh, _) = grid(65, |i, j| {
+            let x = i as f32 - 20.0;
+            (8.0 - x.abs()).max(0.0) + 0.3 * (j as f32 * 0.7).sin()
+        });
+        let dag = template.dag_for(&split_sections(&mesh).0);
+        let mut by_group: std::collections::HashMap<u32, (f32, [f32; 3], f32)> = Default::default();
+        for m in &dag.meshlets {
+            assert!(
+                m.parent_error >= m.self_error,
+                "{} < {}",
+                m.parent_error,
+                m.self_error
+            );
+            assert!(m.parent_radius >= m.self_radius * 0.999);
+        }
+        for (c, m) in dag.meshlets.iter().enumerate() {
+            let g = dag.cluster_group[c];
+            if g == lod::NO_GROUP || m.parent_error.is_infinite() {
+                continue;
+            }
+            let entry =
+                by_group
+                    .entry(g)
+                    .or_insert((m.parent_error, m.parent_center, m.parent_radius));
+            assert_eq!(*entry, (m.parent_error, m.parent_center, m.parent_radius));
+        }
+        // The plain's coarse clusters err less than the ridge's.
+        let top = dag.clusters_per_level.len() as u32 - 1;
+        let errors: Vec<(f32, f32)> = dag
+            .meshlets
+            .iter()
+            .filter(|m| m.lod_level + 1 == top)
+            .map(|m| (m.center[0], m.self_error))
+            .collect();
+        let near = errors
+            .iter()
+            .filter(|e| e.0 < 30.0)
+            .map(|e| e.1)
+            .fold(0.0, f32::max);
+        let far = errors
+            .iter()
+            .filter(|e| e.0 > 45.0)
+            .map(|e| e.1)
+            .fold(0.0, f32::max);
+        assert!(near > far, "ridge {near}, plain {far}");
+    }
+
+    #[test]
+    fn a_mesh_built_from_the_template_has_the_template_s_shape() {
+        let (stand_in, flat) = grid(65, |i, j| noise(i, j, 1));
+        let template = DagTemplate::new(&stand_in, &flat);
+        let (mesh, _) = grid(65, |i, j| noise(i, j, 2) * 3.0);
+        let built = MeshletMesh::build_from(&mesh, &template);
+        let own = MeshletMesh::build(&mesh);
+        assert_eq!(built.triangle_count, own.triangle_count);
+        assert_eq!(
+            built.clusters_per_level.len(),
+            template.dag.clusters_per_level.len()
+        );
+        assert!(built.page_count > 0);
+        let stats = built.dag_stats();
+        assert!(stats.fill > 0.5, "{stats:?}");
+    }
+}
