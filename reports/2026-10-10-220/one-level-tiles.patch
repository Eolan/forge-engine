+/// Quads a side of a tile's surface for the rays when its DAG has one level ([`tile_ray_grid`]):
+/// 3 872 triangles, within the 4 000 a tile's cut takes from its DAG.
+pub const TILE_RAY_QUADS: u32 = 44;
+
+/// The surface of [`tile_mesh`]'s `mesh` (a tile of `samples`² samples) for the rays when its DAG
+/// has one level (D-058's step 3): its grid at [`TILE_RAY_QUADS`] + 1 samples a side, the nearest
+/// to even steps, the skirt left out. Also how far it stands from the tile's samples at most,
+/// metres: what a DAG cut's error is.
+pub fn tile_ray_grid(mesh: &TriMesh, samples: u32) -> (TriMesh, f32) {
+    let n = samples as usize;
+    let quads = (TILE_RAY_QUADS as usize).min(n - 1);
+    // The samples kept along each side, and the quad of the coarse grid each sample lies in.
+    let kept: Vec<usize> = (0..=quads)
+        .map(|k| (k * (n - 1) + quads / 2) / quads)
+        .collect();
+    let mut over = vec![0; n];
+    for (k, pair) in kept.windows(2).enumerate() {
+        over[pair[0]..=pair[1]].fill(k);
+    }
+    let side = quads + 1;
+    let fine = |i: usize, j: usize| glam::Vec3::from(mesh.positions[j * n + i]);
+    let mut grid = TriMesh::default();
+    for &j in &kept {
+        for &i in &kept {
+            grid.positions.push(mesh.positions[j * n + i]);
+            grid.uvs.push(mesh.uvs[j * n + i]);
+        }
+    }
+    let index = |i: usize, j: usize| (j * side + i) as u32;
+    for j in 0..quads {
+        for i in 0..quads {
+            let (a, b, c, d) = (
+                index(i, j),
+                index(i + 1, j),
+                index(i, j + 1),
+                index(i + 1, j + 1),
+            );
+            // As `tile_mesh` splits its quads: a b c, then b d c.
+            grid.indices.extend_from_slice(&[a, b, c, b, d, c]);
+        }
+    }
+    // Each sample against the coarse triangle over it.
+    let mut error = 0.0_f32;
+    for j in 0..n {
+        for i in 0..n {
+            let (ci, cj) = (over[i], over[j]);
+            let (i0, i1, j0, j1) = (kept[ci], kept[ci + 1], kept[cj], kept[cj + 1]);
+            let s = (i - i0) as f32 / (i1 - i0) as f32;
+            let t = (j - j0) as f32 / (j1 - j0) as f32;
+            let on = if s + t <= 1.0 {
+                fine(i0, j0) + s * (fine(i1, j0) - fine(i0, j0)) + t * (fine(i0, j1) - fine(i0, j0))
+            } else {
+                fine(i1, j1)
+                    + (1.0 - s) * (fine(i0, j1) - fine(i1, j1))
+                    + (1.0 - t) * (fine(i1, j0) - fine(i1, j1))
+            };
+            error = error.max(fine(i, j).distance(on));
+        }
+    }
+    (grid, error)
+}
