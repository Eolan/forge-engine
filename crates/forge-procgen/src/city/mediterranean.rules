# The engine's example style set: a Mediterranean-European perimeter block (D-059's first
# style set). Rendered walls in warm tints; tall French windows with shutters; balconies on
# the first floor of the street fronts; shops on the avenues, the lanes, the squares and the
# quays; a string course over the ground floor, a cornice and a parapet. Each building picks
# its balconies, shutters and attic from its seed, so neighbours differ and one building's
# walls agree.
#
# Where the openings go is the building's structure's (D-060, `city::structure`): the style
# dresses them. Three start shapes, with the attributes `city::facades::dress` gives them
# (street, court, party, tiled, floors, street_width, open, and level.index, level.count,
# level.last for a storey):
# - `Storey`: one storey of a street or courtyard wall, its openings as gaps that
#   `openings { Wall | Opening }` cuts at; an opening's shape has `opening.kind` (1 a window,
#   2 a shopfront, 3 the door, 4 a passage into the court), `sill`, `glass` and `lintel`;
# - `PartyWall`: a wall against a neighbour, from the ground to 0.9 m over the roof line;
# - `Roofline`: the 0.9 m over a street or courtyard wall's roof line.

let balconies = 0 | 1 | 1 | 2
let shutters = 0 | 1 | 1 | 1
let attic = 0 | 0 | 1

PartyWall -> insert(blank)

# Above the roof line: a cornice on the street, then the parapet round the roof.
Roofline [tiled] -> split(y) { 0.4: Cornice | ~0.5: Eaves }
Roofline [court] -> Parapet
Roofline -> split(y) { 0.4: Cornice | ~0.5: Parapet }
Eaves -> nil
Cornice -> insert(cornice)
Parapet -> insert(parapet)

# A storey: a string course over the ground floor on the street, the openings in the rest.
Storey [level.index == 0 && street] -> split(y) { ~1: Openings | 0.3: Band }
Storey -> Openings
Band -> insert(band)
Openings -> openings { Wall | Opening }

# The passage into the court: open to its head, the wall over it.
Opening [opening.kind == 4] -> split(y) { glass: Passage | ~1: Wall }
Passage -> nil
# The door, step-free from the pavement.
Opening [opening.kind == 3] -> split(y) { glass: Entrance | ~1: Wall }
Entrance -> insert(door)
# Shops, cafés and bars: an open front or one under an awning.
Opening [opening.kind == 2] -> split(y) { sill: Wall | glass: Shopfront | ~1: Wall }
Shopfront -> choose(index) { 1: ShopOpen | 1: ShopAwning }
ShopOpen -> insert(shop)
ShopAwning -> insert(shop_awning)
# The garden flats' glazed bays onto their terraces: to the floor, the threshold flush (the
# owner's note, 2026-10-15).
Opening [court && level.index == 0 && sill < 0.05] -> split(y) { glass: GardenBay | ~1: Wall }
GardenBay -> insert(bay)
# The courtyards: plain windows.
Opening [court] -> split(y) { sill: Wall | glass: CourtWindow | ~1: Wall }
CourtWindow -> insert(window_court)
# The ground floor's windows on the street.
Opening [level.index == 0] -> split(y) { sill: Wall | glass: LowWindow | ~1: Wall }
LowWindow -> insert(window_low)
# Balconies on the first floor of the street front, and on the top floor too for some
# buildings: French windows to the floor.
Opening [level.index == 1 && balconies >= 1] -> split(y) { 0.1: Wall | ~1: Balcony | lintel: Wall }
Opening [level.last && balconies >= 2 && level.index >= 2] -> split(y) { 0.1: Wall | ~1: Balcony | lintel: Wall }
Balcony -> insert(balcony)
# Or an attic storey: small square windows high in the top floor, under the cornice.
Opening [level.last && attic && level.count >= 4] -> split(y) { ~1: Wall | 1.3: AtticWindow | lintel: Wall }
AtticWindow -> insert(window_court)
# The other upper windows, with shutters for most buildings.
Opening -> split(y) { sill: Wall | glass: Window | ~1: Wall }
Window [shutters] -> choose(index, level.index) { 3: OpenWindow | 1: ClosedWindow }
OpenWindow -> insert(window)
ClosedWindow -> insert(window_closed)
Window -> insert(window_plain)

Wall -> insert(wall)
